# Copy to .env.local for local dev, or set these in the Vercel project
# settings. None of these are required to run Splitty in demo mode.

# Supabase (frontend, safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (server-side only — used by api/stripe-webhook.ts)
SUPABASE_SERVICE_ROLE_KEY=

# Receipt scanning (server-side only — used by api/scan-receipt.ts)
ANTHROPIC_API_KEY=

# Stripe (server-side only)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=
